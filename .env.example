# Copy to .env and adjust. Every setting is optional.
HOLLOW_DATABASE_URL=sqlite:///./hollow.db
HOLLOW_TIMEZONE=Europe/Warsaw
# Study after midnight counts for the previous day until this hour.
HOLLOW_DAY_START_HOUR=4
# Set this before deploying anywhere public: every page then asks for it.
# HOLLOW_PASSWORD=change-me

# Anki sync through the AnkiConnect add-on (code 2055492159). Anki must be open.
HOLLOW_ANKI_ENABLED=true
# Use 127.0.0.1, not localhost: on Windows, localhost adds a ~2 second delay to every call.
HOLLOW_ANKI_URL=http://127.0.0.1:8765
# Comma-separated deck names to count. Leave empty to count every deck.
HOLLOW_ANKI_DECKS=

# GitHub sync: souls for your merged pull requests whose CI passed.
HOLLOW_GITHUB_ENABLED=false
# Comma-separated owner/name repos whose pull requests count.
HOLLOW_GITHUB_REPOS=MBigaj/hollow-trials
# Only pull requests opened by this user count.
HOLLOW_GITHUB_AUTHOR=MBigaj
# Fine-grained token, read-only: Pull requests, Commit statuses and Contents (for checks)
# on the repos above. Needed for private repos; also lifts the rate limit to 5000/hour.
# HOLLOW_GITHUB_TOKEN=github_pat_...
